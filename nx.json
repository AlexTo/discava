{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      {
        "dependentTasksOutputFiles": "!{reports/**,coverage/**,dist/**/checkov/checkov_report.json,dist/**/test-output/vitest/coverage/**}",
        "transitive": true
      }
    ],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/tests/**/*"
    ],
    "sharedGlobals": [],
    "biome": ["default", "{workspaceRoot}/biome.json"]
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "compile",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "ciTargetName": "test-ci",
        "testMode": "watch"
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "bundle",
        "serveTargetName": "serve",
        "devTargetName": "serve",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "typecheckTargetName": "vite:typecheck",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    }
  ],
  "targetDefaults": {
    "compile": {
      "cache": true,
      "syncGenerators": ["@nx/js:typescript-sync", "@aws/nx-plugin:ts#sync"],
      "inputs": ["default"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["default"]
    },
    "@nx/vitest:test": {
      "cache": true,
      "inputs": ["default", "^production"],
      "configurations": {
        "update-snapshot": {
          "args": "--update"
        }
      }
    },
    "build": {
      "cache": true,
      "inputs": ["default"]
    },
    "lint": {
      "syncGenerators": ["@aws/nx-plugin:license#sync"]
    }
  },
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true,
        "style": "css",
        "linter": "none",
        "bundler": "vite"
      },
      "component": {
        "style": "css"
      },
      "library": {
        "style": "css",
        "linter": "none"
      }
    }
  },
  "parallel": 8
}
