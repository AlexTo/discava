{
  "name": "@discava/common-scripts",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/common/scripts/src",
  "projectType": "library",
  "tags": [],
  "metadata": {
    "generator": "ts#project"
  },
  "targets": {
    "reset-local-data": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/local-data/reset.ts",
        "cwd": "{projectRoot}"
      }
    },
    "local-oidc": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "tsx src/local-oidc/start-container.ts",
        "cwd": "{projectRoot}"
      }
    },
    "s3mock": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "tsx src/s3mock/start-container.ts",
        "cwd": "{projectRoot}"
      }
    },
    "assemble": {
      "dependsOn": ["compile"]
    },
    "build": {
      "dependsOn": ["lint", "compile", "test"]
    },
    "compile": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/tsc"],
      "options": {
        "command": "tsc --build tsconfig.lib.json",
        "cwd": "{projectRoot}"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["biome"],
      "options": {
        "command": "biome format {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome format --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "format",
        {
          "projects": ["@discava/source"],
          "target": "license-check"
        }
      ],
      "cache": true,
      "inputs": ["biome"],
      "options": {
        "command": "biome lint {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome check --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    },
    "test": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/scripts/setup-stage.sh"
      ]
    }
  }
}
