{
  "name": "@discava/common-scripts",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/common/scripts/src",
  "projectType": "library",
  "tags": [],
  "metadata": {
    "generator": "ts#project"
  },
  "targets": {
    "reindex-search": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/infra/reindex-search.ts {args.stage}",
        "cwd": "{projectRoot}"
      }
    },
    "agent-issue": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/agent-issues/main.ts",
        "cwd": "{projectRoot}"
      }
    },
    "agent-ci-status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/agent-ci/main.ts",
        "cwd": "{projectRoot}"
      }
    },
    "agent-review-status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/agent-review/main.ts",
        "cwd": "{projectRoot}"
      }
    },
    "ui-screenshots": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/ui-screenshots/main.ts",
        "cwd": "{projectRoot}"
      }
    },
    "screenshots-comment": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/ui-screenshots/comment-main.ts",
        "cwd": "{projectRoot}"
      }
    },
    "entity-writers": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/invariant-coverage/write.ts",
        "cwd": "{projectRoot}"
      }
    },
    "invariant-coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/invariant-coverage/main.ts",
        "cwd": "{projectRoot}"
      }
    },
    "validate-tasks": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/agent-issues/validate-main.ts",
        "cwd": "{projectRoot}"
      }
    },
    "reset-local-data": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/local-data/reset.ts",
        "cwd": "{projectRoot}"
      }
    },
    "rebuild-analytics": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/analytics/rebuild-analytics.ts",
        "cwd": "{projectRoot}"
      }
    },
    "seed-categories": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/seed-categories/seed.ts",
        "cwd": "{projectRoot}"
      }
    },
    "notify-local": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/notify-local/notify.ts",
        "cwd": "{projectRoot}"
      }
    },
    "local-oidc": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["pull-local-oidc-image"],
      "options": {
        "command": "tsx src/local-oidc/start-container.ts",
        "cwd": "{projectRoot}"
      }
    },
    "s3mock": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["pull-s3mock-image"],
      "options": {
        "command": "tsx src/s3mock/start-container.ts",
        "cwd": "{projectRoot}"
      }
    },
    "elasticmq": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["pull-elasticmq-image"],
      "options": {
        "command": "tsx src/elasticmq/start-container.ts",
        "cwd": "{projectRoot}"
      }
    },
    "pull-local-oidc-image": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/local-oidc/pull-image.ts",
        "cwd": "{projectRoot}"
      }
    },
    "pull-s3mock-image": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/s3mock/pull-image.ts",
        "cwd": "{projectRoot}"
      }
    },
    "pull-elasticmq-image": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/elasticmq/pull-image.ts",
        "cwd": "{projectRoot}"
      }
    },
    "assemble": {
      "dependsOn": ["compile"]
    },
    "build": {
      "dependsOn": [
        "lint",
        "compile",
        "test",
        {
          "projects": ["@discava/source"],
          "target": "graphify-update"
        }
      ]
    },
    "compile": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/tsc"],
      "options": {
        "command": "tsc --build tsconfig.lib.json",
        "cwd": "{projectRoot}"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["biome"],
      "options": {
        "command": "biome format {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome format --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "format",
        {
          "projects": ["@discava/source"],
          "target": "license-check"
        }
      ],
      "cache": true,
      "inputs": ["biome"],
      "options": {
        "command": "biome lint {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome check --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    },
    "test": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/scripts/setup-stage.sh"
      ]
    }
  }
}
