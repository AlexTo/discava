{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../../../dist/packages/common/tiptap/tsc",
    "tsBuildInfoFile": "../../../dist/packages/common/tiptap/tsc/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    // Consumed by the portals (bundler resolution) as well as instructor-api.
    // Under NodeNext, a portal resolving this project's imports through its
    // project reference picks Tiptap's CommonJS declarations while its own
    // code gets the ES module ones, and the two Editor types don't match.
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ]
}
