{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../../../dist/packages/common/portal-utils/tsc",
    "tsBuildInfoFile": "../../../dist/packages/common/portal-utils/tsc/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "types": [
      "node"
    ],
    "lib": [
      "es2022",
      "DOM"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
