{
  "name": "@discava/tooling-agent",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/tooling/agent/src",
  "projectType": "library",
  "tags": [],
  "metadata": {
    "generator": "ts#project"
  },
  "targets": {
    "agent-issue": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/agent-issues/main.ts",
        "cwd": "{projectRoot}"
      }
    },
    "archive-specs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/agent-issues/archive-main.ts",
        "cwd": "{projectRoot}"
      }
    },
    "agent-ci-status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/agent-ci/main.ts",
        "cwd": "{projectRoot}"
      }
    },
    "agent-review-status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/agent-review/main.ts",
        "cwd": "{projectRoot}"
      }
    },
    "ui-screenshots": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/ui-screenshots/main.ts",
        "cwd": "{projectRoot}"
      }
    },
    "screenshots-comment": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/ui-screenshots/comment-main.ts",
        "cwd": "{projectRoot}"
      }
    },
    "entity-writers": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/invariant-coverage/write.ts",
        "cwd": "{projectRoot}"
      }
    },
    "invariant-coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/invariant-coverage/main.ts",
        "cwd": "{projectRoot}"
      }
    },
    "validate-tasks": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/agent-issues/validate-main.ts",
        "cwd": "{projectRoot}"
      }
    },
    "assemble": {
      "dependsOn": ["compile"]
    },
    "build": {
      "dependsOn": [
        "lint",
        "compile",
        "test",
        {
          "projects": ["@discava/source"],
          "target": "graphify-update"
        }
      ]
    },
    "compile": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/tsc"],
      "options": {
        "command": "tsc --build tsconfig.lib.json",
        "cwd": "{projectRoot}"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["biome"],
      "options": {
        "command": "biome format {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome format --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "format",
        {
          "projects": ["@discava/source"],
          "target": "license-check"
        }
      ],
      "cache": true,
      "inputs": ["biome"],
      "options": {
        "command": "biome lint {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome check --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"]
    }
  }
}
