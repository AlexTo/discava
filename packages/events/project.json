{
  "name": "@discava/events",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/events/src",
  "projectType": "library",
  "tags": [],
  "metadata": {
    "generator": "ts#project",
    "components": [
      {
        "generator": "ts#lambda-function",
        "path": "src/identity/post-confirmation.ts",
        "name": "post-confirmation",
        "iac": "cdk"
      },
      {
        "generator": "ts#lambda-function",
        "path": "src/media/transcode-complete.ts",
        "name": "transcode-complete",
        "iac": "cdk"
      },
      {
        "generator": "ts#lambda-function",
        "path": "src/media/transcode-cleanup.ts",
        "name": "transcode-cleanup",
        "iac": "cdk"
      },
      {
        "generator": "ts#lambda-function",
        "path": "src/progress/progress-recalculation.ts",
        "name": "progress-recalculation",
        "iac": "cdk"
      },
      {
        "generator": "ts#lambda-function",
        "path": "src/media/transcode-reconciler.ts",
        "name": "transcode-reconciler",
        "iac": "cdk"
      }
    ]
  },
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["@discava/core-table"],
          "target": "dev"
        },
        {
          "projects": ["@discava/common-scripts"],
          "target": "s3mock"
        }
      ],
      "continuous": true,
      "options": {
        "commands": ["tsx --watch src/local/event-runner.ts"],
        "cwd": "{projectRoot}",
        "env": {
          "LOCAL_DEV": "true",
          "POWERTOOLS_DEV": "true",
          "POWERTOOLS_TRACE_ENABLED": "false",
          "POWERTOOLS_METRICS_DISABLED": "true"
        }
      }
    },
    "assemble": {
      "dependsOn": ["compile", "bundle"]
    },
    "build": {
      "dependsOn": ["lint", "compile", "test", "bundle"]
    },
    "bundle": {
      "executor": "nx:run-commands",
      "dependsOn": ["compile"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/bundle"],
      "inputs": ["default"],
      "options": {
        "command": "rolldown -c rolldown.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "compile": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/tsc"],
      "options": {
        "command": "tsc --build tsconfig.lib.json",
        "cwd": "{projectRoot}"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["biome"],
      "options": {
        "command": "biome format {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome format --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "format",
        {
          "projects": ["@discava/source"],
          "target": "license-check"
        }
      ],
      "cache": true,
      "inputs": ["biome"],
      "options": {
        "command": "biome lint {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome check --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    }
  }
}
